# FastAPI
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=sqlite:///./alpha_research.db

# Security
SECRET_KEY=your-secret-key-change-in-production
AES_KEY=your-aes-256-key-base64-encoded

# BRAIN API (optional - users provide via dashboard)
BRAIN_EMAIL=
BRAIN_PASSWORD=

# OpenAI/Claude API
OPENAI_API_KEY=
CLAUDE_API_KEY=

# BRAIN pacing guardrails
BRAIN_REQUEST_INTERVAL_SECONDS=5
BRAIN_RATE_LIMIT_COOLDOWN_SECONDS=90
BRAIN_POLL_ACCOUNT_GAP_SECONDS=30

# Slack Alerts
SLACK_WEBHOOK_URL=

# SendGrid Email
SENDGRID_API_KEY=

# Monitoring
LOG_LEVEL=INFO
